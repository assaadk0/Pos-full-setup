*% 7198xx4xReceipt.GPD History
*% 11/19/2007   Added knife cut feature for selecting knife cut on endPage, endDoc,.
*% or endJob.  SCER ATL1803. Version 4.0.1
*%
*% 1/21/2008   Added knife cut feature for selecting knife cut on endPage, endDoc,.
*% or endJob to all models.  SCER ATL1803. Version 4.0.2
*%
*%
*% 02/18/08 Printable Area Change	Himani
*%
*%
*GPDSpecVersion: "1.0"
*Include: "StdNames.gpd"
*GPDFileVersion: "5.0.0"
*GPDFileName: "7198xx4xLR.GPD"
*ModelName: "NCR 7198xx4x Label Receipt"
*MasterUnits: PAIR(203, 204)
*ResourceDLL: "POSPTR.Dll"
*PrinterType: SERIAL
*FontCartSlots: 1
*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *rcNameID: 279
        *OptionID: 279
    }
}
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option2
    *Option: Option1
    {
        *Name: "203 x 68 " =DOTS_PER_INCH
        *DPI: PAIR(203, 68)
        *TextDPI: PAIR(203, 68)
        *PinsPerLogPass: 8
        *PinsPerPhysPass: 8
        *MinStripBlankPixels:204
        EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "<1B>*<01>" %l{NumOfDataBytes} }
    }
    *Option: Option2
    {
        *Name: "203 x 203 " =DOTS_PER_INCH
        *DPI: PAIR(203, 204)
        *TextDPI: PAIR(203, 204)
        *PinsPerLogPass: 24
        *PinsPerPhysPass: 24
        *MinStripBlankPixels:204
        EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "<1B>*<21>" %l{ (NumOfDataBytes)/3} }
    }
}
*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *rcNameID: 261
        *OptionID: 261

	*%Printable Area Change
        *%*PageDimensions: PAIR(630, 3940)
        *%*PrintableArea: PAIR(584, 3816)
        *%*PrintableOrigin: PAIR(32, 120)

        *PageDimensions: PAIR(640, 3940)
        *PrintableArea: PAIR(575, 3775)
        *PrintableOrigin: PAIR(32, 138)

        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "<1F0700>"
        }
    }
    *Option: Option2
    {
        *rcNameID: 262
        *OptionID: 262

	*%Printable Area Change
        *%*PageDimensions: PAIR(417, 3940)
        *%*PrintableArea: PAIR(377, 3816)
        *%*PrintableOrigin: PAIR(20, 120)

        *PageDimensions: PAIR(463, 3940)
        *PrintableArea: PAIR(423, 3775)
        *PrintableOrigin: PAIR(20, 140)



        *%CursorOrigin: PAIR(0, 0)
    }
}
*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_AUTO
    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }
    *Option: HT_PATSIZE_SUPERCELL_M
    {
        *rcNameID: =HT_SUPERCELL_DISPLAY
    }
    *Option: HT_PATSIZE_6x6_M
    {
        *rcNameID: =HT_DITHER6X6_DISPLAY
    }
    *Option: HT_PATSIZE_8x8_M
    {
        *rcNameID: =HT_DITHER8X8_DISPLAY
    }
}

****************
*% SS 11/12/2009

*Feature: KnifeBuzzer
{
	*Name:"Alert Tone on Knife Cut"
	*FeatureType: PRINTER_PROPERTY
	*DefaultOption:Disable	
   *Option:Enable
	{
		*Name:"Enable"
		*Command:CmdSelect
		{
			*Order:DOC_SETUP.5
			*Cmd:"<1F115401FF>"
		}
	}
	*Option:Disable
	{
		*Name:"Disable"
		*Command:CmdSelect
		{
			*Order:DOC_SETUP.5
			*Cmd:"<1F115400FF>"
		}
	}
 }
 
 *%
 *% cannot use the standard media type feature here
 *% because it will always go to Document setup property page
 *% renaming it to MediaType1 since it is still the media type which 
 *% differs between label, thermal and auto.
 *%
*Feature: MediaType1
{
    *Name: "Paper Type"
	*FeatureType: PRINTER_PROPERTY
    *DefaultOption: Auto
    *Option: Thermal
    {
        *Name: "Thermal Paper"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: "<1F115202FF>"
        }
    }
    *Option: Label
    {
        *Name: "Label Paper"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.6
            *Cmd: "<1F115201FF>"
        }
    }
	*Option: Auto
    {
        *Name: "Auto"
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.2
            *Cmd: "<1F115200FF>"
        }
    }
}
*% end of chnages by SS
*% SCER ATL1803 mkr 11/7/2007
*Feature: KnifeCut
{
    *rcNameID:300
    *DefaultOption:Option1
    *Option:Option1
    {
        *rcNameID: 301
        *OptionID: 301
    }
    *Option:Option2
    {
        *rcNameID: 302
        *OptionID: 302
    }
    *Option:Option3
    {
        *rcNameID: 303
        *OptionID: 303
    }
}
*% End SCER ATL1803 mkr 11/7/2007

*Command: CmdStartDoc
{
    *Order: DOC_SETUP.1
    *Cmd: "<1B>@<1B>c4<00>"
}
*%Allow configure knife cut
*% SCER ATL1803 mkr 11/7/2007
*switch: KnifeCut
{
   *% End of page knife cut
    *case: Option1
    {
      *Command: CmdEndPage
      {
        *Order: PAGE_FINISH.1
        *Cmd: "<0D0D0D0D0D0D0D19>"
      }
      *Command: CmdEndDoc
      {
        *Order: DOC_FINISH.1
        *Cmd: "<10>"
      }

      *Command: CmdEndJob
      {
      }
    }
   *% End of document knife cut
    *case: Option2
    {
      *Command: CmdEndPage
      {
      }
      *Command: CmdEndDoc
      {
        *Order: DOC_FINISH.1
        *Cmd: "<0D0D0D0D0D0D0D19>"
      }
      *Command: CmdEndJob
      {
        *Order: JOB_FINISH.1
        *Cmd: "<10>"
      }


    }
   *% End of job knife cut
    *case: Option3
    {
      *Command: CmdEndPage
      {
      }
      *Command: CmdEndDoc
      {
      }
      *Command: CmdEndJob
      {
        *Order: JOB_FINISH.10
        *Cmd: "<10>"
        *Order: JOB_FINISH.20
        *Cmd: "<0D0D0D0D0D0D0D19>"
      }

    }
}
*% End SCER ATL1803 mkr 11/7/2007

*RotateCoordinate?: FALSE
*RotateRaster?: FALSE
*RotateFont?: FALSE
*TextCaps: LIST(TC_OP_CHARACTER,TC_EA_DOUBLE,TC_IA_ABLE,TC_UA_ABLE)
*CursorXAfterCR: AT_CURSOR_X_ORIGIN
*BadCursorMoveInGrxMode: LIST(Y_PORTRAIT,Y_LANDSCAPE)
*YMoveAttributes: LIST(SEND_CR_FIRST)
*YMoveThreshold: *
*YMoveUnit: 204
*Command: CmdYMoveRelDown { *Cmd : "<1B>J" %c{DestYRel} }
*Command: CmdSetLineSpacing { *Cmd : "<1B>3" %c{LinefeedSpacing} }
*Command: CmdCR { *Cmd : "<0D>" }
*Command: CmdLF { *Cmd : "<0A>" }
*Command: CmdFF { *Cmd : "<0C>" }
*Command: CmdBackSpace { *Cmd : "<08>" }
*EjectPageWithFF?: TRUE
*OutputDataFormat: V_BYTE
*OptimizeLeftBound?: FALSE
*CursorXAfterSendBlockData: AT_GRXDATA_END
*CursorYAfterSendBlockData: AUTO_INCREMENT
*DefaultCTT: 1
*DefaultFont: 1
*switch: Orientation
{
    *case: PORTRAIT
    {
        *DeviceFonts: LIST(1,2,3,4,5,6,7,8)
    }
    *case: LANDSCAPE_CC270
    {
        *DeviceFonts: LIST(1)
    }
}
*Command: CmdBoldOn { *Cmd : "<1B>E<01>" }
*Command: CmdBoldOff { *Cmd : "<1B>E<00>" }
*Command: CmdItalicOn { *Cmd : "<1B>I1" }
*Command: CmdItalicOff { *Cmd : "<1B>I0" }
*Command: CmdUnderlineOn { *Cmd : "<1B>-1" }
*Command: CmdUnderlineOff { *Cmd : "<1B>-0" }
