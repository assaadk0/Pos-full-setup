*% 7198R.GPD 2-sided printer
*% 02/1/2008   Use 2 sided with 2 sided commands in simplex mode, Knife cut feature and
*% 2ST feature for selecting split receipt, 2 sided or 2 sided with form.
*% for performance reasons.
*%
*% 2/15/2008     Printable Area change
*%
*% 05/15/08  Updated thermal Printing feature 	     Himani
*%
*GPDSpecVersion: "1.0"
*Include: "StdNames.gpd"
*GPDFileVersion: "5.0.0"
*GPDFileName: "7198R.GPD"
*ModelName: "NCR 7198 Receipt"
*MasterUnits: PAIR(203, 204)
*ResourceDLL: "POSPTR.Dll"
*PrinterType: SERIAL
*FontCartSlots: 1

*% Feature Display Oder
*Feature: Orientation
{
    *Option: PORTRAIT{}
    *Option: LANDSCAPE_CC270{}
}
*Feature: ReversePrint
{
    *Option: Option1{}
    *Option: Option2{}
    *Option: Option3{}
    *Option: Option4{}
}
*Feature: TopBottomMessage
{
    *Option: Option1{}
    *Option: Option2{}
    *Option: Option3{}
    *Option: Option4{}
}
*Feature: InputBin
{
    *Option: Option1{}
}
*Feature: Resolution
{
    *Option: Option1{}
    *Option: Option2{}
}
*Feature: PaperSize
{
    *Option: Option1{}
    *Option: Option2{}
}
*Feature: Duplex
{
    *Option: NONE{}
    *Option: VERTICAL{}
    *Option: HORIZONTAL{}
}
*Feature: KnifeCut
{
    *Option: ENDPAGE{}
    *Option: ENDDOC{}
    *Option: ENDJOB{}
}
*% end Feature Display Oder

*Feature: Orientation
{
    *ConflictPriority:  1
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *rcNameID: 279
        *OptionID: 279
    }
}
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option2
    *Option: Option1
    {
        *Name: "203 x 68 " =DOTS_PER_INCH
        *DPI: PAIR(203, 68)
        *TextDPI: PAIR(203, 68)
        *PinsPerLogPass: 8
        *PinsPerPhysPass: 8
        *MinStripBlankPixels:204
        EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "<1B>*<01>" %l{NumOfDataBytes} }
    }
    *Option: Option2
    {
        *Name: "203 x 203 " =DOTS_PER_INCH
        *DPI: PAIR(203, 204)
        *TextDPI: PAIR(203, 204)
        *PinsPerLogPass: 24
        *PinsPerPhysPass: 24
        *MinStripBlankPixels:204
        EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "<1B>*<21>" %l{ (NumOfDataBytes)/3} }
      }

}
*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *rcNameID: 261
        *OptionID: 261

*%Printable Area Change
*%      *PageDimensions: PAIR(630, 3940)
*%      *PrintableArea: PAIR(584, 3816)
*%	*PrintableOrigin: PAIR(32, 120)

	*PageDimensions: PAIR(640, 3940)
        *PrintableArea: PAIR(575, 3775)
        *PrintableOrigin: PAIR(38, 140)


        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "<1F0700>"
        }
    }
    *Option: Option2
    {
        *rcNameID: 262
        *OptionID: 262

*%Printable Area Change
*%      *PageDimensions: PAIR(417, 3940)
*%      *PrintableArea: PAIR(377, 3782)
*%      *PrintableOrigin: PAIR(20, 120)

	*PageDimensions: PAIR(463, 3940)
        *PrintableArea: PAIR(421, 3775)
        *PrintableOrigin: PAIR(14, 140)


    }
}

*% Start custom
*Feature: ReversePrint
{
    *rcNameID: 281
*%    *Name: "Upside_Down_Printing"
    *FeatureType: DOC_PROPERTY
    *DefaultOption: Option1
    *Option: Option1
    {
       *rcNameID: 282
*%        *Name: "Off"
*%        *Command: CmdSelect
  *%      {
  *%          *Order: DOC_SETUP.30  *% select off upside down printing
  *%          *Cmd: "<1F6300>"
   *%     }
    }
    *Option: Option2
    {
       *rcNameID: 283
*%        *Name: "Front_Side_Only"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.30  *% select Front side upside down printing only
            *Cmd: "<1F6301>"
        }
    }
    *Option: Option3
    {
        *Constraints: Duplex.NONE
        *rcNameID: 284
*%        *Name: "Back_Side_Only"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.30  *% select back side upside down printing only
            *Cmd: "<1F6302>"
        }
    }
    *Option: Option4
    {
        *Constraints: Duplex.NONE
       *rcNameID: 285
*%        *Name: "Both_Sides"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.30  *% select upside down printing on both sides
            *Cmd: "<1F6303>"
        }
    }
}

*Feature: TopBottomMessage
{
    *rcNameID: 286
*%        *Name: "TopBottomMessage"
    *FeatureType: DOC_PROPERTY
    *DefaultOption: Option1
    *Option: Option1
    {
       *rcNameID: 282
*%        *Name: "Disable"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.40  *% select disable top bottom message printing
            *Cmd: "<1F6600>"
        }
    }
    *Option: Option2
    {
        *Constraints: Duplex.NONE
       *rcNameID: 283
*%        *Name: "EnableFront"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.40  *% select Front side message printing only
            *Cmd: "<1F6601>"
        }
    }
    *Option: Option3
    {
        *Constraints: Duplex.NONE
       *rcNameID: 284
*%        *Name: "EnableBack"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.40  *% select back side message printing only
            *Cmd: "<1F6602>"
        }
    }
    *Option: Option4
    {
        *Constraints: Duplex.NONE
       *rcNameID: 285
*%        *Name: "EnableBoth"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.40  *% select Front and back side message printing only
            *Cmd: "<1F6603>"
        }
    }
}
*% 2 sided mode 2 sided command in simplex
*Feature: TwoSidedThermal
{
    *rcNameID: 287
*%        *Name: "Two-Sided Thermal"
    *FeatureType: DOC_PROPERTY
    *DefaultOption: Option2
    *Option: Option1
    {
        *Constraints: Duplex.VERTICAL
        *Constraints: Duplex.HORIZONTAL
       *rcNameID: 288
*%        *Name: "Single Side"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.50  *% select disable 2 sided mode 2 sided commands
            *Cmd: "<1F6000>"
        }
    }
    *Option: Option2
    {
        *Constraints: Duplex.VERTICAL
        *Constraints: Duplex.HORIZONTAL
       *rcNameID: 289
*%        *Name: "Single Side Buffered"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.50  *% select enable 2 sided mode 2 sided commands, single side only
            *Cmd: "<1F6002>"
        }
    }
     *Option: Option3
    {
        *Constraints: Duplex.NONE
	*rcNameID: 304
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.50  *% select enable 2 sided mode 2 sided commands, single side only
            *Cmd: "<1F6002>"
        }
	 *Command: CmdStartPage
        {
            *Order: PAGE_SETUP.1  *% select enable 2 sided mode 2 sided commands, single side only
            *CallbackID: 28
        }

    }
    *Option: Option4
    {
        *Constraints: Duplex.NONE
       *rcNameID: 290
*%        *Name: "Split Receipt"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.50  *% select enable 2 sided mode 1 sided commands
            *Cmd: "<1F6001>"
        }
    }
    *Option: Option5
    {
        *Constraints: Duplex.NONE
       *rcNameID: 292
*%        *Name: "Duplex Predefined Image"
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.50  *% select enable 2 sided mode with predefined image on side 2
            *Cmd: "<1F6003>"
        }
    }
*% mkr 7/28/2006  Uncomment Option 5 when PageMode is implemented.
*%    *Option: Option5
*%    {
*%        *Constraints: Duplex.NONE
*%       *rcNameID: 291
*%        *Command: CmdSelect
*%        {
*%            *Order: DOC_SETUP.50  *% select enable 2 sided mode 2 sided commands
*%            *Cmd: "<1F6002>"
*%        }
*%    }
} *% end TwoSidedThermal

*% end custom

*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_AUTO
    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }
    *Option: HT_PATSIZE_SUPERCELL_M
    {
        *rcNameID: =HT_SUPERCELL_DISPLAY
    }
    *Option: HT_PATSIZE_6x6_M
    {
        *rcNameID: =HT_DITHER6X6_DISPLAY
    }
    *Option: HT_PATSIZE_8x8_M
    {
        *rcNameID: =HT_DITHER8X8_DISPLAY
    }
}
*Feature: Duplex
{
*%    *ConflictPriority:  2
    *rcNameID: =TWO_SIDED_PRINTING_DISPLAY
    *DefaultOption: NONE
    *Option: NONE
    {
        *Constraints: TwoSidedThermal.Option3
*% mkr 7/28/2006 Uncomment Option 4 and 5 when PageMode implemented.
        *Constraints: TwoSidedThermal.Option4
        *Constraints: TwoSidedThermal.Option5
        *rcNameID: =NONE_DISPLAY
*%        *Command: CmdSelect
*%        {
*%            *Order: DOC_SETUP.20  *% select single-sided with single-sided command
*%            *Cmd: "<1F6000>"
*%        }
    }
    *Option: VERTICAL
    {
*%        *Constraints: Orientation. PORTRAIT
        *Constraints: TwoSidedThermal.Option1
        *Constraints: TwoSidedThermal.Option2
        *rcNameID: =FLIP_ON_LONG_EDGE_DISPLAY
*%        *Command: CmdSelect
*%        {
*%            *Order: DOC_SETUP.20  *% select double-sided with single-sided command
*%            *Cmd: "<1F6001>"
*%         }
    }
    *Option: HORIZONTAL
    {
*%        *Constraints: Orientation. LANDSCAPE_CC270
        *Constraints: TwoSidedThermal.Option1
        *Constraints: TwoSidedThermal.Option2
        *rcNameID: =FLIP_ON_SHORT_EDGE_DISPLAY
	 *Command: CmdSelect
        {
            *Order: DOC_SETUP.30  *% select back side upside down printing only
            *Cmd: "<1F6302>"
        }
*%        *Command: CmdSelect
*%        {
*%            *Order: DOC_SETUP.20  *% select double-sided with single-sided command
*%            *Cmd: "<1F6001>"
*%        }
    }
}

*% SCER ATL1803 mkr 11/7/2007
*Feature: KnifeCut
{
    *rcNameID:300
    *DefaultOption:ENDPAGE
    *Option:ENDPAGE
    {
        *%Constraints: Duplex.NONE *%constraint controversial with default duplex option
        *rcNameID: 301
        *OptionID: 301
    }
    *Option:ENDDOC
    {
        *%Constraints: Duplex.NONE *%constraint controversial with default duplex option
        *rcNameID: 302
        *OptionID: 302
    }
    *Option:ENDJOB
    {
        *%Constraints: Duplex.NONE *%constraint controversial with default duplex option
        *rcNameID: 303
        *OptionID: 303
    }
}
*% End SCER ATL1803 mkr 11/7/2007

*Command: CmdStartDoc
{
    *Constraints: Duplex.NONE
    *Order: DOC_SETUP.1
    *Cmd: "<1B>@<1B>c4<00>"
}
*%Allow configure knife cut
*% SCER ATL1803 mkr 11/7/2007
*switch: KnifeCut
{
   *% End of page knife cut
    *case: ENDPAGE
    {
      *Command: CmdEndPage
      {
        *Order: PAGE_FINISH.1
	 *CallbackID: 29
*%        *Cmd: "<0D0D0D0D0D0D0D19>"
      }
      *Command: CmdEndDoc
      {
        *Order: DOC_FINISH.1
	*CallbackID: 30
*%        *Cmd: "<10>"
      }

      *Command: CmdEndJob
      {
      }
    }
   *% End of document knife cut
    *case: ENDDOC
    {
      *Command: CmdEndPage
      {
      }
      *Command: CmdEndDoc
      {
        *Order: DOC_FINISH.1
	*CallbackID: 31
*%        *Cmd: "<0D0D0D0D0D0D0D19>"
      }
      *Command: CmdEndJob
      {
        *Order: JOB_FINISH.1
        *Cmd: "<10>"
      }


    }
   *% End of job knife cut
    *case: ENDJOB
    {
      *Command: CmdEndPage
      {
      }
      *Command: CmdEndDoc
      {
      }
      *Command: CmdEndJob
      {
        *Order: JOB_FINISH.10
        *Cmd: "<10>"
        *Order: JOB_FINISH.20
	*CallbackID: 31
*%        *Cmd: "<0D0D0D0D0D0D0D19>"
      }

    }
}
*% End SCER ATL1803 mkr 11/7/2007


*RotateCoordinate?: FALSE
*RotateRaster?: FALSE
*RotateFont?: FALSE
*TextCaps: LIST(TC_OP_CHARACTER,TC_EA_DOUBLE,TC_IA_ABLE,TC_UA_ABLE)
*CursorXAfterCR: AT_CURSOR_X_ORIGIN
*BadCursorMoveInGrxMode: LIST(Y_PORTRAIT,Y_LANDSCAPE)
*YMoveAttributes: LIST(SEND_CR_FIRST)
*YMoveThreshold: *
*YMoveUnit: 204
*Command: CmdYMoveRelDown { *Cmd : "<1B>J" %c{DestYRel} }
*Command: CmdSetLineSpacing { *Cmd : "<1B>3" %c{LinefeedSpacing} }
*Command: CmdCR { *Cmd : "<0D>" }
*Command: CmdLF { *Cmd : "<0A>" }
*Command: CmdFF { *Cmd : "<0C>" }
*Command: CmdBackSpace { *Cmd : "<08>" }
*EjectPageWithFF?: TRUE
*OutputDataFormat: V_BYTE
*OptimizeLeftBound?: FALSE
*CursorXAfterSendBlockData: AT_GRXDATA_END
*CursorYAfterSendBlockData: AUTO_INCREMENT
*DefaultCTT: 1
*DefaultFont: 1
*switch: Orientation
{
    *case: PORTRAIT
    {
        *DeviceFonts: LIST(1,2,3,4,5,6,7,8)
    }
    *case: LANDSCAPE_CC270
    {
        *DeviceFonts: LIST(1)
    }
}

*switch: Duplex
{
    *case: NONE
    {
        *Command: CmdEndPage
        {
   *Order: PAGE_FINISH.10 *% seven CR then paper cut
*%   *Cmd: "<0D0D0D0D0D0D0D19>"
        }
    }
    *case: VERTICAL
    {
        *Command: CmdEndPage
        {
  *Order: PAGE_FINISH.10  *% FF
  *Cmd: "<0C>"
        }
        *Command: CmdEndDoc
        {
  *Order: DOC_FINISH.10 *% seven CR then Knife cut
 *% *Cmd: "<0D0D0D0D0D0D0D19>"
        }
    }
    *case: HORIZONTAL
    {
        *Command: CmdEndPage
        {
  *Order: PAGE_FINISH.10  *% FF
  *Cmd: "<0C>"
        }
        *Command: CmdEndDoc
        {
  *Order: DOC_FINISH.10 *% seven CR then Knife cut
*%  *Cmd: "<0D0D0D0D0D0D0D19>"
        }
    }
} *%switch Duplex

