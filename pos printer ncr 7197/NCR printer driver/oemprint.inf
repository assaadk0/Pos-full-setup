[NCRPOSPTR_FILE]
POSPTR.DLL
NCR_RSD_LM.dll
NCROEMUNI.INI
NCROEMUNI.DLL

[UNIDRV_BIDI_DATA]
POSPTR.Dll
LanguageMonitor=%NCR_MONITOR%

[OEMUNI]
ncroemuni.dll

[DestinationDirs]
DefaultDestDir=66000
NCRPOSPTR_FILE=66000

[SourceDisksNames.x86]
1 = %disk1%,,,

[SourceDisksNames.amd64]
1 = %disk1%,,,

[SourceDisksFiles]
