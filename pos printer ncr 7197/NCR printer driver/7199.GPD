*%
*%
*% 7199Receipt.GPD History
*%
*GPDSpecVersion: "1.0"
*Include: "StdNames.gpd"
*GPDFileVersion: "5.0.0"
*GPDFileName: "7199.GPD"
*ModelName: "NCR 7199 Receipt"
*MasterUnits: PAIR(203, 204)
*ResourceDLL: "POSPTR.Dll"
*PrinterType: SERIAL
*FontCartSlots: 1

*RotateCoordinate?: FALSE
*RotateRaster?: FALSE
*RotateFont?: FALSE
*TextCaps: LIST(TC_OP_CHARACTER,TC_EA_DOUBLE,TC_IA_ABLE,TC_UA_ABLE)
*CursorXAfterCR: AT_CURSOR_X_ORIGIN
*BadCursorMoveInGrxMode: LIST(Y_PORTRAIT,Y_LANDSCAPE)
*YMoveAttributes: LIST(SEND_CR_FIRST)
*YMoveThreshold: *
*YMoveUnit: 204
*EjectPageWithFF?: TRUE
*OutputDataFormat: V_BYTE
*OptimizeLeftBound?: FALSE
*CursorXAfterSendBlockData: AT_GRXDATA_END
*CursorYAfterSendBlockData: NO_MOVE
*DefaultCTT: 1
*DefaultFont: 1

*% Start of Features
*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}

*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: RECEIPT
    *Option: RECEIPT
    {
        *rcNameID: 279
        *OptionID: 279
    }
}

*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: DPI203X203
    *Option: DPI203X68
    {
        *Name: "203 x 68 " =DOTS_PER_INCH
        *DPI: PAIR(203, 68)
        *TextDPI: PAIR(203, 68)
        *PinsPerLogPass: 8
        *PinsPerPhysPass: 8
        *MinStripBlankPixels:204
        EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "<1B>*<01>" %l{NumOfDataBytes} }
    }
    *Option: DPI203X203
    {
        *Name: "203 x 203 " =DOTS_PER_INCH
        *DPI: PAIR(203, 204)
        *TextDPI: PAIR(203, 204)
        *PinsPerLogPass: 24
        *PinsPerPhysPass: 24
        *MinStripBlankPixels:204
        EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "<1B>*<21>" %l{ (NumOfDataBytes)/3} }
    }
}

*Feature: PaperSize
{
    *rcNameID: =PAPER_SIZE_DISPLAY
    *DefaultOption: Option1
    *Option: PAPER_SIZE80MM
    {
        *rcNameID: 261
        *OptionID: 261
        *PageDimensions: PAIR(640, 3940)
        *PrintableArea: PAIR(575, 3775)
        *PrintableOrigin: PAIR(32, 138)
        
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "<1F0700>"
        }
    }
    *Option: PAPER_SIZE58MM
    {
        *rcNameID: 262
        *OptionID: 262
        *PageDimensions: PAIR(463, 3940)
        *PrintableArea: PAIR(423, 3775)
        *PrintableOrigin: PAIR(20, 140)
        *Command: CmdSelect
        {
            *Order: DOC_SETUP.2
            *Cmd: "<1F0700>"
        }
    }
}

*Feature: ColorMode
{
    *rcNameID: =COLOR_PRINTING_MODE_DISPLAY
    *DefaultOption: MONO

    *Option: MONO
    {
        *rcNameID: =MONO_DISPLAY
        *DrvBPP: 1
        *DevNumOfPlanes: 1
        *DevBPP: 1
        *Color?: FALSE
    }
}

*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_AUTO

    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }
    *Option: HT_PATSIZE_SUPERCELL_M
    {
        *rcNameID: =HT_SUPERCELL_DISPLAY
    }
    *Option: HT_PATSIZE_6x6_M
    {
        *rcNameID: =HT_DITHER6X6_DISPLAY
    }
    *Option: HT_PATSIZE_8x8_M
    {
        *rcNameID: =HT_DITHER8X8_DISPLAY
    }
}

*Feature: KnifeCut
{
    *rcNameID:300
    *DefaultOption:END_OF_PAGE

    *Option: END_OF_PAGE
    {
        *rcNameID: 301
        *OptionID: 301
    }
    *Option: END_OF_DOC
    {
        *rcNameID: 302
        *OptionID: 302
    }
    *Option: END_OF_JOB
    {
        *rcNameID: 303
        *OptionID: 303
    }
}

*% Start of Switch cases
*switch: KnifeCut
{
    *case: END_OF_PAGE
    {
      *Command: CmdEndPage
      {
        *Order: PAGE_FINISH.1
        *Cmd: "<0D0D0D0D0D0D0D19>"
      }
      *Command: CmdEndDoc
      {
      }
      *Command: CmdEndJob
      {
        *Order: JOB_FINISH.1
        *Cmd: "<10>"
      }
    }
    *case: END_OF_DOC
    {
      *Command: CmdEndPage
      {
      }
      *Command: CmdEndDoc
      {
        *Order: DOC_FINISH.1
        *Cmd: "<0D0D0D0D0D0D0D19>"
      }
      *Command: CmdEndJob
      {
        *Order: JOB_FINISH.1
        *Cmd: "<10>"
      }
    }
    *case: END_OF_JOB
    {
      *Command: CmdEndPage
      {
      }
      *Command: CmdEndDoc
      {
      }
      *Command: CmdEndJob
      {
        *Order: JOB_FINISH.20
        *Cmd: "<0D0D0D0D0D0D0D19>"
        *Order: JOB_FINISH.10
        *Cmd: "<10>"
      }
    }
}

*switch: Orientation
{
    *case: PORTRAIT
    {
        *DeviceFonts: LIST(1,2,3,4,5,6,7,8)
    }
    *case: LANDSCAPE_CC270
    {
        *DeviceFonts: LIST(1)
    }
}

*% Start of Commands
*Command: CmdStartDoc
{
    *Order: DOC_SETUP.1
    *Cmd: "<1B>@<1B>c4<00>"
}

*Command: CmdYMoveRelDown { *Cmd : "<1B>J" %c{DestYRel} }
*Command: CmdSetLineSpacing { *Cmd : "<1B>3" %c{LinefeedSpacing} }
*Command: CmdCR { *Cmd : "<0D>" }
*Command: CmdLF { *Cmd : "<0A>" }
*Command: CmdFF { *Cmd : "<0C>" }
*Command: CmdBackSpace { *Cmd : "<08>" }

*Command: CmdBoldOn { *Cmd : "<1B>E<01>" }
*Command: CmdBoldOff { *Cmd : "<1B>E<00>" }
*Command: CmdItalicOn { *Cmd : "<1B>I1" }
*Command: CmdItalicOff { *Cmd : "<1B>I0" }
*Command: CmdUnderlineOn { *Cmd : "<1B>-1" }
*Command: CmdUnderlineOff { *Cmd : "<1B>-0" }

