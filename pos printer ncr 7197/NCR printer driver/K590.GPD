*GPDSpecVersion: "1.0"
*Include: "StdNames.gpd"
*GPDFileVersion: "5.0.2"
*GPDFileName: "K590.GPD"
*ModelName: "NCR K590 Self-Service"
*MasterUnits: PAIR(203, 204)
*ResourceDLL: "POSPTR.Dll"
*PrinterType: SERIAL
*FontCartSlots: 1
*Feature: Orientation
{
    *rcNameID: =ORIENTATION_DISPLAY
    *DefaultOption: PORTRAIT
    *Option: PORTRAIT
    {
        *rcNameID: =PORTRAIT_DISPLAY
    }
    *Option: LANDSCAPE_CC270
    {
        *rcNameID: =LANDSCAPE_DISPLAY
    }
}
*Feature: InputBin
{
    *rcNameID: =PAPER_SOURCE_DISPLAY
    *DefaultOption: Option1
    *Option: Option1
    {
        *rcNameID: 279
        *OptionID: 279
    }
}
*Feature: Resolution
{
    *rcNameID: =RESOLUTION_DISPLAY
    *DefaultOption: Option2
    *Option: Option1
    {
        *Name: "203 x 68 " =DOTS_PER_INCH
        *DPI: PAIR(203, 68)
        *TextDPI: PAIR(203, 68)
        *PinsPerLogPass: 8
        *PinsPerPhysPass: 8
        *MinStripBlankPixels:204
        EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "<1B>*<01>" %l{NumOfDataBytes} }
    }
    *Option: Option2
    {
        *Name: "203 x 203 "=DOTS_PER_INCH
        *DPI: PAIR(203, 204)
        *TextDPI: PAIR(203, 204)
        *PinsPerLogPass: 24
        *PinsPerPhysPass: 24
        *MinStripBlankPixels:204
        EXTERN_GLOBAL: *StripBlanks: LIST(TRAILING)
        *SpotDiameter: 100
        *Command: CmdSendBlockData { *Cmd : "<1B>*<21>" %l{ (NumOfDataBytes)/3} }
      }
}
